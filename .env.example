# ==============================================================================
# TV Remote — Optional Environment Configuration
# Copy this file to `.env` (or `~/Library/Application Support/TVRemote/.env`)
# Only needed if you want to override default runtime behavior.
# Note: Apple TV pairing credentials are NEVER stored in `.env` or plain files;
# they are stored exclusively in the encrypted macOS Keychain.
# ==============================================================================

# Explicit path to a Python 3.11+ interpreter (optional; auto-detected by default)
TVREMOTE_PYTHON_BIN=

# Custom location for the isolated pyatv virtual environment
# Default: ~/Library/Application Support/TVRemote/venv
TVREMOTE_VENV_DIR=

# macOS Keychain service name used to store paired Companion & AirPlay credentials
TVREMOTE_KEYCHAIN_SERVICE=com.hudson.TVRemote.credentials

# Optional comma-separated Apple TV IPv4 address(es) for direct unicast discovery
# Useful on segmented VLANs where mDNS / Bonjour multicast is blocked (e.g. 192.168.1.50)
TVREMOTE_DEFAULT_HOST=

# Logging verbosity for the Python pyatv bridge (DEBUG, INFO, WARNING, ERROR)
TVREMOTE_LOG_LEVEL=WARNING

# Build-time option for scripts/build_app.sh:
# Set to 1 to copy site-packages inside TV Remote.app/Contents/Resources (local personal builds only;
# leave 0 when distributing binaries to avoid bundling LGPL-2.1 transitive dependency `zeroconf`)
TVREMOTE_BUNDLE_SITE_PACKAGES=0
